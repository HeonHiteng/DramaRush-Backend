# Copy to scripts/.env and fill in real values (gitignored — never commit this file).
# Used only by the operator scripts in this folder, on an admin's machine.

# Supabase project (Settings -> API). The service role key bypasses Row Level
# Security entirely: never put it in the app, never commit or share it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare (dashboard -> right sidebar shows the Account ID).
CLOUDFLARE_ACCOUNT_ID=your-account-id
# API token with permission "Stream: Edit" only.
CLOUDFLARE_STREAM_API_TOKEN=your-stream-edit-token
# Optional, for the cost guard (stream-usage-sync): token with "Account Analytics: Read" only.
CLOUDFLARE_ANALYTICS_API_TOKEN=

# Optional: printed by `npm run cloudflare-setup -- --watermark logo.png`.
STREAM_WATERMARK_UID=
# Optional: comma-separated web origins allowed to embed videos (e.g. keybox.app,*.keybox.app).
STREAM_ALLOWED_ORIGINS=
