# Copy to scripts/.env and fill in real values (gitignored — never commit this file).
# Get these from your Supabase project: Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely. Never use
# it in the app, never commit it, never share it — it has full admin access
# to every table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
